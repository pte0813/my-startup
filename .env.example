# 랜딩페이지 설정. 이 파일을 복사해 .env를 만들고 값을 채운다.
# .env는 저장소에 올리지 않는다(.gitignore에 등록됨).

# Supabase 프로젝트 주소 (대시보드 > Project Settings > API > Project URL)
SUPABASE_URL=

# Supabase anon(publishable) 키. 공개되어도 되는 키만 넣는다.
# service_role 키는 절대 넣지 않는다.
SUPABASE_ANON_KEY=

# 사전신청 안내 문구 등에 쓰는 서비스 이름
SITE_NAME=X

# 문의하기 이메일 발송 (Resend). 서버(Vercel 함수)에서만 읽는다. 페이지에 넣지 않는다.
# Resend API 키 (resend.com > API Keys)
RESEND_API_KEY=
# 문의를 받을 이메일 주소
CONTACT_TO_EMAIL=
# 발신 주소. 도메인 인증 전에는 onboarding@resend.dev만 쓸 수 있다.
CONTACT_FROM_EMAIL=onboarding@resend.dev
